# CreativeLift AI local development defaults. Do not use these values in production.
APP_ENV=development
APP_NAME=CreativeLift AI
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEMO_API_KEY=dev-api-key
NEXT_PUBLIC_DEMO_API_KEY=dev-api-key

DATABASE_URL=postgresql+psycopg://creativelift:creativelift_dev@localhost:5432/creativelift
REDIS_URL=redis://localhost:6379/0
RESOURCE_REPOSITORY_BACKEND=memory

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
REQUEST_BODY_LIMIT_BYTES=1048576

API_KEY_PEPPER=change-me-in-production
JWT_ISSUER=creativelift-local
JWT_AUDIENCE=creativelift-api

OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
DATA_RETENTION_DAYS=730
